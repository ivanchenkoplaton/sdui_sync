# SDUI Sync Configuration Example
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control!

# SDUI Configuration
# Get these values from SDUI web app (DevTools -> Network -> api.sdui.app requests)
SDUI_USER_ID='YOUR_USER_ID_HERE'
SDUI_AUTH_TOKEN='Bearer YOUR_TOKEN_HERE'
SDUI_EMAIL='your.email@example.com'
SDUI_PASSWORD='your_password_here'
SDUI_SCHOOL_ID='YOUR_SCHOOL_ID'
SDUI_SCHOOL_SLINK='your_school_slink'

# Google Calendar Configuration
# Leave as 'primary' to use your main calendar
GOOGLE_CALENDAR_ID='primary'

# Timezone (e.g., Europe/Berlin, America/New_York, UTC)
TIMEZONE='UTC'

# Sync Configuration
# Set to 'true' to sync only changes (substitutions, cancellations, exams)
# Set to 'false' to sync all events including regular lessons
SYNC_ONLY_CHANGES='false'

# Year for date parsing (DDMM format)
SYNC_YEAR='2026'
